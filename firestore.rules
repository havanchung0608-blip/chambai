rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isTeacher() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) && 
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email;
    }

    // --- EXAMS ---
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        isValidId(examId) &&
        incoming().teacherId == request.auth.uid;
      allow update, delete: if isSignedIn() && 
        isValidId(examId) &&
        existing().teacherId == request.auth.uid;
    }

    // --- SUBMISSIONS ---
    match /submissions/{submissionId} {
      function canAccessSubmission(data) {
        return data.teacherId == request.auth.uid || 
               data.studentId == request.auth.uid ||
               get(/databases/$(database)/documents/exams/$(data.examId)).data.teacherId == request.auth.uid;
      }

      allow list: if isSignedIn() && canAccessSubmission(resource.data);
      allow get: if isSignedIn() && isValidId(submissionId) && canAccessSubmission(resource.data);

      allow create: if isSignedIn() && 
        isValidId(submissionId) &&
        incoming().studentId == request.auth.uid;

      allow update: if isSignedIn() && 
        isValidId(submissionId) &&
        canAccessSubmission(existing());
      
      allow delete: if isSignedIn() && 
        isValidId(submissionId) &&
        (existing().teacherId == request.auth.uid || 
         get(/databases/$(database)/documents/exams/$(existing().examId)).data.teacherId == request.auth.uid);
    }

    // --- LOGS ---
    match /examCodeChangeLogs/{logId} {
      allow read: if isSignedIn() && 
        isValidId(logId) &&
        existing().teacherId == request.auth.uid;
      allow create: if isSignedIn() && 
        isValidId(logId) &&
        incoming().teacherId == request.auth.uid &&
        get(/databases/$(database)/documents/exams/$(incoming().examId)).data.teacherId == request.auth.uid;
    }

    // --- TRÒ CHƠI "LÊN CHÙA HỌC TOÁN" ---
    // Cấu hình chung: mọi người đăng nhập được đọc, chỉ giáo viên được sửa.
    match /gameConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // Tiến độ của từng học sinh (mã tài liệu = uid học sinh).
    // Học sinh chỉ ghi tiến độ của mình và không tự đổi được trường "blocked".
    // Học sinh đang bị khóa không ghi được gì.
    match /gameProgress/{userId} {
      allow get: if isOwner(userId) || isTeacher();
      allow list: if isTeacher();
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == userId &&
        incoming().get('blocked', false) == false;
      allow update: if isTeacher() ||
        (isOwner(userId) &&
         existing().get('blocked', false) == false &&
         incoming().get('blocked', false) == false &&
         incoming().uid == userId);
      allow delete: if isTeacher();
    }

    // Lịch sử từng lượt chơi.
    match /gameSessions/{sessionId} {
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow read: if isTeacher() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }
  }
}
